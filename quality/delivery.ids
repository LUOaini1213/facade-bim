<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>Facade BIM IFC delivery requirements</title>
        <description>Check original panel identity, actual Rhino parts/materials and formal 4D task metadata. Geometry and task relationships are checked separately.</description>
    </info>
    <specifications>
        <specification name="Panel identity and schedule fields" ifcVersion="IFC4" identifier="F-PANEL">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCPLATE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[SENW]-(L[1-8]|RF)-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </attribute>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Panel</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>PanelID</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[SENW]-(L[1-8]|RF)-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Panel</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>PanelType</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="U1" />
                            <xs:enumeration value="U2" />
                            <xs:enumeration value="U3" />
                            <xs:enumeration value="U4" />
                            <xs:enumeration value="U5" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Panel</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>InstallDate</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Panel</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>DeliveryDate</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Panel</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Stillage</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="ST-[0-9]{3}" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_RhinoUserText</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>pid</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[SENW]-(L[1-8]|RF)-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="Actual Rhino part identity and material" ifcVersion="IFC4" identifier="F-PART">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGELEMENTPART</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value=".+" />
                        </xs:restriction>
                    </value>
                </attribute>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Part</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>PanelID</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[SENW]-(L[1-8]|RF)-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Part</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>PartKind</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="alu" />
                            <xs:enumeration value="glass" />
                            <xs:enumeration value="spandrel" />
                            <xs:enumeration value="insulation" />
                            <xs:enumeration value="louver" />
                            <xs:enumeration value="door" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Part</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>RhinoObjectID</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value=".+" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Part</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>MaterialName</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value=".+" />
                        </xs:restriction>
                    </value>
                </property>
                <material cardinality="required" />
            </requirements>
        </specification>
        <specification name="Formal construction and delivery task metadata" ifcVersion="IFC4" identifier="F-TASK">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCTASK</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value=".+" />
                        </xs:restriction>
                    </value>
                </attribute>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Identification</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="(INSTALL:[SENW]-(L[1-8]|RF)-[0-9]{2}|DELIVERY:ST-[0-9]{3})" />
                        </xs:restriction>
                    </value>
                </attribute>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Task</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>TimeGranularity</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>DAY</simpleValue>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Task</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>EventDate</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}" />
                        </xs:restriction>
                    </value>
                </property>
                <property cardinality="required">
                    <propertySet>
                        <simpleValue>FacadeBIM_Task</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Source</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>Rhino UserText</simpleValue>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="Named formal work schedule" ifcVersion="IFC4" identifier="F-SCHEDULE">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWORKSCHEDULE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value=".+" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
    </specifications>
</ids>