{
  "title": "Facade BIM IFC delivery requirements",
  "description": "Check original panel identity, actual Rhino parts/materials and formal 4D task metadata. Geometry and task relationships are checked separately.",
  "ifc_versions": [
    "IFC4"
  ],
  "model": "facade_bim.ifc",
  "specifications": [
    {
      "id": "F-PANEL",
      "name": "Panel identity and schedule fields",
      "entity": "IFCPLATE",
      "attributes": [
        {
          "name": "Name",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Panel",
          "name": "PanelID",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "PanelType",
          "values": [
            "U1",
            "U2",
            "U3",
            "U4",
            "U5"
          ]
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "InstallDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "DeliveryDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "Stillage",
          "pattern": "ST-[0-9]{3}"
        },
        {
          "pset": "FacadeBIM_RhinoUserText",
          "name": "pid",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        }
      ]
    },
    {
      "id": "F-PART",
      "name": "Actual Rhino part identity and material",
      "entity": "IFCBUILDINGELEMENTPART",
      "material": true,
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Part",
          "name": "PanelID",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "PartKind",
          "values": [
            "alu",
            "glass",
            "spandrel",
            "insulation",
            "louver",
            "door"
          ]
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "RhinoObjectID",
          "pattern": ".+"
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "MaterialName",
          "pattern": ".+"
        }
      ]
    },
    {
      "id": "F-TASK",
      "name": "Formal construction and delivery task metadata",
      "entity": "IFCTASK",
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        },
        {
          "name": "Identification",
          "pattern": "(INSTALL:[SENW]-(L[1-8]|RF)-[0-9]{2}|DELIVERY:ST-[0-9]{3})"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Task",
          "name": "TimeGranularity",
          "value": "DAY"
        },
        {
          "pset": "FacadeBIM_Task",
          "name": "EventDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Task",
          "name": "Source",
          "value": "Rhino UserText"
        }
      ]
    },
    {
      "id": "F-SCHEDULE",
      "name": "Named formal work schedule",
      "entity": "IFCWORKSCHEDULE",
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        }
      ]
    }
  ]
}
