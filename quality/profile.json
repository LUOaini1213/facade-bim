{
  "title": "Facade BIM IFC delivery requirements",
  "description": "Check original panel identity, actual Rhino parts/materials and formal 4D task metadata. Geometry and task relationships are checked separately.",
  "ifc_versions": [
    "IFC4"
  ],
  "model": "facade_bim.ifc",
  "specifications": [
    {
      "id": "F-PANEL",
      "name": "Panel identity and schedule fields",
      "entity": "IFCPLATE",
      "attributes": [
        {
          "name": "Name",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Panel",
          "name": "PanelID",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "PanelType",
          "values": [
            "U1",
            "U2",
            "U3",
            "U4",
            "U5"
          ]
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "InstallDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "DeliveryDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Panel",
          "name": "Stillage",
          "pattern": "ST-[0-9]{3}"
        },
        {
          "pset": "FacadeBIM_RhinoUserText",
          "name": "pid",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        }
      ]
    },
    {
      "id": "F-PART",
      "name": "Actual Rhino part identity and material",
      "entity": "IFCBUILDINGELEMENTPART",
      "material": true,
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Part",
          "name": "PanelID",
          "pattern": "[SENW]-(L[1-8]|RF)-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "PartKind",
          "values": [
            "alu",
            "glass",
            "spandrel",
            "insulation",
            "louver",
            "door"
          ]
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "RhinoObjectID",
          "pattern": ".+"
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "MaterialName",
          "pattern": ".+"
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "PartRole",
          "values": [
            "ROOF_COPING",
            "RHINO_BLOCK_PART"
          ]
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "GeometryRepresentation",
          "values": [
            "CONSTRUCTION_ENVELOPE",
            "SOURCE_GEOMETRY"
          ]
        }
      ]
    },
    {
      "id": "F-TASK",
      "name": "Formal construction and delivery task metadata",
      "entity": "IFCTASK",
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        },
        {
          "name": "Identification",
          "pattern": "(INSTALL:[SENW]-(L[1-8]|RF)-[0-9]{2}|DELIVERY:ST-[0-9]{3})"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Task",
          "name": "TimeGranularity",
          "value": "DAY"
        },
        {
          "pset": "FacadeBIM_Task",
          "name": "EventDate",
          "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
        },
        {
          "pset": "FacadeBIM_Task",
          "name": "Source",
          "value": "Rhino UserText"
        }
      ]
    },
    {
      "id": "F-SCHEDULE",
      "name": "Named formal work schedule",
      "entity": "IFCWORKSCHEDULE",
      "attributes": [
        {
          "name": "Name",
          "pattern": ".+"
        }
      ]
    },
    {
      "id": "F-COPING",
      "name": "Roof coping fabrication and construction envelope semantics",
      "entity": "IFCBUILDINGELEMENTPART",
      "applicability_attributes": [
        {
          "name": "Name",
          "pattern": "[SENW]-RF-[0-9]{2}/08 alu"
        }
      ],
      "properties": [
        {
          "pset": "FacadeBIM_Part",
          "name": "PartRole",
          "value": "ROOF_COPING"
        },
        {
          "pset": "FacadeBIM_Part",
          "name": "GeometryRepresentation",
          "value": "CONSTRUCTION_ENVELOPE"
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "PhysicalThicknessMM",
          "datatype": "IFCREAL",
          "min_exclusive": 0
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "FabricationLengthMM",
          "datatype": "IFCREAL",
          "min_exclusive": 0
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "FabricationWidthMM",
          "datatype": "IFCREAL",
          "min_exclusive": 0
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "MaterialDensityKGPerM3",
          "datatype": "IFCREAL",
          "min_exclusive": 0
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "PhysicalMassKG",
          "datatype": "IFCREAL",
          "min_exclusive": 0
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "EnvelopeHeightMM",
          "datatype": "IFCREAL",
          "min_exclusive": 0
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "QuantityBasis",
          "value": "FLAT_SHEET_NOT_ENVELOPE_VOLUME"
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "Assumption",
          "value": "FICTIONAL_DEMONSTRATION_INPUTS"
        },
        {
          "pset": "FacadeBIM_Coping",
          "name": "SourceModelSHA256",
          "pattern": "[0-9a-f]{64}"
        }
      ]
    }
  ]
}
